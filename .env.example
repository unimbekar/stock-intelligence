# Local only. Copy to .env. Do not put production secrets here.

APP_NAME=Meridian
ENVIRONMENT=local
DATA_MODE=mock
AI_PROVIDER=local

# Host-run API. Inside Docker Compose these are overridden.
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5433/meridian
REDIS_URL=redis://localhost:6379/0

API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000,http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:8000

# Leave LOCAL_AI_MODEL empty to use the offline explainer.
# This machine has qwen3.6:latest in Ollama.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=qwen3.6:latest

# Dev-only signing key. Replace outside this machine.
SECRET_KEY=local-dev-only-change-me
LOG_LEVEL=INFO

POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=meridian

RATE_LIMIT_PER_MINUTE=120

# Alert email. Leave SMTP_HOST empty to keep alerts on the page only.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TLS=true
ALERT_WATCH=true
ALERT_CHECK_SECONDS=300
